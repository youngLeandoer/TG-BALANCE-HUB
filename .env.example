# ===========================================
# TELEGRAM BOT CONFIGURATION
# ===========================================
BOT_TOKEN=your_telegram_bot_token_here
BOT_ADMINS=123456789,987654321
# Общий «рабочий» Telegram user id для всех сервисов (одна сущность в БД). 0 = использовать первый ID из BOT_ADMINS.
SHARED_WORKSPACE_TG_ID=0

# ===========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===========================================
DB_USER=postgres
DB_PASSWORD=change_this_secure_password
DB_NAME=balance_hub
DB_HOST=postgres
DB_PORT=5432

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# SECURITY (Encryption Key - 32 bytes base64)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ===========================================
ENCRYPTION_KEY=your_32_byte_secret_key_here

# ===========================================
# WEB SERVER CONFIGURATION (For OAuth)
# ===========================================
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_DOMAIN=https://your-domain.com

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Moscow

# ===========================================
# CELERY CONFIGURATION
# ===========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ===========================================
# INTERNAL/LOCAL HELPERS
# ===========================================
INTERNAL_UPDATE_TOKEN=change_this_long_random_token
# Read-only JSON API (/api/v1/...): Authorization: Bearer <token> or X-API-Token. Empty = routes return 503.
API_TOKEN=JBv3Q1oDajTCiuvH8IslLgVS0NlQquD3
LOW_BALANCE_THRESHOLD_RUB=1000

# Optional: run local Playwright scrapers inside server/worker before building reports.
# If enabled, scrapers will push balances via /internal/*/balance and the daily stats will include them.
LOCAL_SCRAPERS_ENABLED=false
# Base URL where web is reachable (can include path prefix like https://<domain>/balance-hub)
LOCAL_SCRAPERS_BASE_URL=http://localhost:8000
# Optional subset: adminvps,atlex,nic (empty = all)
LOCAL_SCRAPERS_ONLY=

# Daily report to Telegram group/channel (UTC schedule)
DAILY_STATS_ENABLED=false
DAILY_STATS_CHAT_ID=0
DAILY_STATS_HOUR_UTC=7
DAILY_STATS_MINUTE_UTC=0
# Test mode: if >0, send report every N minutes instead of daily schedule
DAILY_STATS_INTERVAL_MINUTES=0

# Local AdminVPS browser helper (optional) — см. tools/adminvps_local_browser.py
ADMINVPS_LOCAL_TG_ID=123456789
ADMINVPS_LOCAL_LABEL=Main
ADMINVPS_LOCAL_BASE_URL=http://localhost:8000
ADMINVPS_LOCAL_CURRENCY=RUB
ADMINVPS_DASHBOARD_URL=https://my.adminvps.ru/
ADMINVPS_WAIT_LOGIN_SECONDS=20
ADMINVPS_LOCAL_LOGIN=
ADMINVPS_LOCAL_PASSWORD=

# Local ATLEX browser helper (optional) — см. tools/atlex_local_browser.py
ATLEX_LOCAL_TG_ID=123456789
ATLEX_LOCAL_LABEL=Main
ATLEX_LOCAL_BASE_URL=http://localhost:8000
ATLEX_LOCAL_CURRENCY=RUB
ATLEX_DASHBOARD_URL=https://client.atlex.ru/
ATLEX_LOCAL_CLIENT=ООО "АТРИ"
ATLEX_LOCAL_CLIENT_ID=6947
ATLEX_LOCAL_LOGIN=
ATLEX_LOCAL_PASSWORD=

# Local NIC.RU browser helper (optional) — см. tools/nic_local_browser.py
NIC_LOCAL_TG_ID=123456789
NIC_LOCAL_LABEL=Main
NIC_LOCAL_BASE_URL=http://localhost:8000
NIC_LOCAL_CURRENCY=RUB
NIC_DASHBOARD_URL=https://www.nic.ru/manager/
NIC_LOCAL_LOGIN=
NIC_LOCAL_PASSWORD=
NIC_WAIT_LOGIN_SECONDS=60
