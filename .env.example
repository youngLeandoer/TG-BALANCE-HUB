# ===========================================
# TELEGRAM BOT CONFIGURATION
# ===========================================
BOT_TOKEN=your_telegram_bot_token_here
BOT_ADMINS=123456789,987654321

# ===========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===========================================
DB_USER=postgres
DB_PASSWORD=change_this_secure_password
DB_NAME=balance_hub
DB_HOST=postgres
DB_PORT=5432

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# SECURITY (Encryption Key - 32 bytes base64)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ===========================================
ENCRYPTION_KEY=your_32_byte_secret_key_here

# ===========================================
# WEB SERVER CONFIGURATION (For OAuth)
# ===========================================
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_DOMAIN=https://your-domain.com

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO

# ===========================================
# CELERY CONFIGURATION
# ===========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ===========================================
# INTERNAL/LOCAL HELPERS
# ===========================================
INTERNAL_UPDATE_TOKEN=change_this_long_random_token

# Local Mango browser helper (optional)
MANGO_LOCAL_TG_ID=123456789
MANGO_LOCAL_LABEL=Mango Main
MANGO_LOCAL_BASE_URL=http://localhost:8000
MANGO_LOCAL_CURRENCY=RUB
MANGO_LOCAL_LOGIN=
MANGO_LOCAL_PASSWORD=
